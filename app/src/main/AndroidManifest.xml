<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.dord.offlineattendance">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-sdk
        tools:overrideLibrary="com.pehchaan.backend" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:name="com.dord.offlineattendance.MyApplication"
        android:allowBackup="false"
        tools:replace="android:theme,android:allowBackup,android:icon,android:roundIcon"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_new"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_new_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:configChanges="locale|layoutDirection"
        tools:targetApi="31"
        android:theme="@style/Theme.Attendance" >
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />
        <activity
            android:name="com.dord.offlineattendance.presentation.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Attendance" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.pehchaan.backend.service.AuthenticationActivity"
            android:theme="@style/Theme.Attendance.AppCompat" />
        <activity
            android:name="com.pehchaan.backend.camera.CameraActivity"
            android:theme="@style/Theme.Attendance.AppCompat" />
    </application>

</manifest>